<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version='0.1' xmlns='http://www.tableau.com/xml/extension_manifest'>
  <worksheet-extension id='pk.gallup.elections.dashboard' extension-version='1.0.0'>
    <default-locale>en_US</default-locale>
    <name>Pakistan Elections 1970-2024</name>
    <description>Interactive, fully custom-coded dashboard exploring Pakistan's National Assembly election results, 1970-2024: balance of power over time, turnout trends, a rotating globe, a province-level results map, a searchable constituency explorer, and a guided "Play Explainer" tour through every election. Reads its data live from the Tableau worksheet, so updating the underlying data source updates the dashboard automatically.</description>
    <author name='Kamran Sultan' email='noreply@example.com' organization='' website='https://www.gallup.com.pk/' />
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://kamransultan55.github.io/pakistan-elections-tableau-extension/extension/index.html?ext=1</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <encoding id='field'>
      <display-name>Data</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>discrete-measure</role-type>
        <role-type>continuous-dimension</role-type>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count='50' />
      <encoding-icon token='level' />
    </encoding>
  </worksheet-extension>
</manifest>
