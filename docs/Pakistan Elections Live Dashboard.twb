      <column caption='Margin Pct' datatype='real' name='[Calculation_2219978130767880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2219978130538498] &gt; 0 THEN [Calculation_2219978130731015] / [Calculation_2219978130538498] * 100 END' />
