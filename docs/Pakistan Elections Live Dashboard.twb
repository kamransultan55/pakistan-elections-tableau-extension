      </column>
      <column caption='Is Winner' datatype='boolean' name='[Calculation_2219978130575363]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Votes] = [Calculation_2219978130419712]' />
      </column>
      <column caption='Winner Party' datatype='string' name='[Calculation_2219978130616324]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Year],[NA] : MAX(IF [Votes]=[Calculation_2219978130419712] THEN [Party] END) }' />
      </column>
      <column caption='Second Max Votes' datatype='integer' name='[Calculation_2219978130657285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Year],[NA] : MAX(IF [Votes] &lt; [Calculation_2219978130419712] THEN [Votes] END) }' />
      </column>
      <column caption='Runner Up Party' datatype='string' name='[Calculation_2219978130694150]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Year],[NA] : MAX(IF [Votes]=[Calculation_2219978130657285] THEN [Party] END) }' />
      </column>
      <column caption='Margin' datatype='integer' name='[Calculation_2219978130731015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2219978130419712] - [Calculation_2219978130657285]' />
